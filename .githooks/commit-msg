#!/bin/sh
# commit-msg hook:
#   1. Strip AI-attribution trailers (Co-Authored-By: Claude/Anthropic,
#      "Generated with [Claude Code]") from the message — automatically.
#   2. Reject a commit whose author/committer identity is an AI (anthropic.com
#      email, or a "Claude <model>" name).
#   3. Enforce Conventional Commits on the subject line.

msg_file="$1"

# --- 1. Strip AI-attribution trailers (auto-fix) ----------------------------
# A Claude model name: "claude" + a separator, an optional version (e.g. 3.5),
# then a model. Requiring the separator avoids matching e.g. "claudehaiku@...".
claude_model='claude[ _-]+([0-9.]+[ _-]+)?(opus|sonnet|haiku|code)'
# Anchored to line start so prose that merely *mentions* these phrases is kept.
# The emoji footer is matched via a non-alphanumeric prefix (no literal emoji,
# which can break grep in a C locale); "[[]?" is a POSIX-portable optional "[".
# The trailer match is narrowed to Anthropic / a Claude model so a human
# co-author named "Claude" is preserved. Pattern is lowercase so awk's
# tolower() below gives case-insensitive matching.
strip_re="^[[:space:]]*(co-authored-by:.*(anthropic|$claude_model)|[^[:alnum:]]*generated with [[]?claude code)"
if grep -iqE "$strip_re" "$msg_file"; then
    tmp="$msg_file.aiclean"
    # Single awk pass (case-insensitive, matching the detection above): drop the
    # attribution lines plus any trailing blank lines they leave. No pipeline, so
    # a partial failure can't clobber the message; only replace on success.
    awk -v re="$strip_re" '
        tolower($0) !~ re { l[++n] = $0; if ($0 !~ /^[[:space:]]*$/) last = n }
        END { for (i = 1; i <= last; i++) print l[i] }
    ' "$msg_file" > "$tmp" && mv "$tmp" "$msg_file"
    echo "commit-msg: stripped AI-attribution trailer(s)"
fi

# --- 2. Reject an AI author/committer identity ------------------------------
idents="$(git var GIT_AUTHOR_IDENT 2>/dev/null) $(git var GIT_COMMITTER_IDENT 2>/dev/null)"
idents="$idents $GIT_AUTHOR_NAME $GIT_AUTHOR_EMAIL $GIT_COMMITTER_NAME $GIT_COMMITTER_EMAIL"
if printf '%s' "$idents" | grep -qiE "@anthropic[.]com|$claude_model"; then
    echo "ERROR: commit author/committer identity looks like an AI:"
    echo "  author:    $(git var GIT_AUTHOR_IDENT 2>/dev/null)"
    echo "  committer: $(git var GIT_COMMITTER_IDENT 2>/dev/null)"
    echo ""
    echo "Set a human identity, e.g.:"
    echo "  git config user.name  \"Your Name\""
    echo "  git config user.email \"you@example.com\""
    exit 1
fi

# --- 3. Conventional Commits ------------------------------------------------
msg=$(head -n 1 "$msg_file")
printf '%s\n' "$msg" | grep -qE '^(Merge |Revert )' && exit 0
printf '%s\n' "$msg" | grep -qE '^(feat|fix|refactor|docs|test|ci|chore|perf|style|build|revert)(\(.+\))?!?: .+' || {
    echo "ERROR: Commit message must follow Conventional Commits format:"
    echo "  <type>(<scope>): <description>"
    echo ""
    echo "  Types: feat, fix, refactor, docs, test, ci, chore, perf, style, build, revert"
    echo "  Example: feat(server): add per-stream encryption"
    echo ""
    echo "  Got: $msg"
    exit 1
}
